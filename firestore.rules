rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || (request.auth.token.keys().hasAny(['email']) && request.auth.token.email.matches('athyx@athyx-network\\.local')));
    }

    function validMessage() {
      return request.resource.data.text is string
        && request.resource.data.text.size() >= 0
        && request.resource.data.text.size() <= 100
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.userId == request.auth.uid;
    }

    function validOwnProfile() {
      return request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && !request.resource.data.nickname.matches('.*\\s.*')
        && (!request.resource.data.keys().hasAny(['username']) || (!request.resource.data.username.matches('.*\\s.*') && request.resource.data.username.size() >= 1 && request.resource.data.username.size() <= 20))
        && request.resource.data.role == 'member'
        && request.resource.data.banned is bool
        && request.resource.data.keys().hasAll(['deviceId'])
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() >= 5
        && request.resource.data.deviceId.size() <= 100
        && !exists(/databases/$(database)/documents/banned_devices/$(request.resource.data.deviceId));
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if signedIn() && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned && validMessage();
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /conversations/{convId} {
      allow read: if signedIn() && (convId.matches('.*' + request.auth.uid + '.*') || (resource != null && resource.data.keys().hasAny(['participants']) && request.auth.uid in resource.data.participants) || isAdmin());
      allow create, update: if signedIn()
        && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned
        && (convId.matches('.*' + request.auth.uid + '.*') || isAdmin());
      allow delete: if isAdmin() || (signedIn() && (convId.matches('.*' + request.auth.uid + '.*') || (resource != null && resource.data.keys().hasAny(['participants']) && request.auth.uid in resource.data.participants)));

      match /messages/{messageId} {
        allow read: if signedIn() && (convId.matches('.*' + request.auth.uid + '.*') || isAdmin());
        allow create: if signedIn()
          && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned
          && (convId.matches('.*' + request.auth.uid + '.*') || isAdmin())
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 0
          && request.resource.data.text.size() <= 100
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 1
          && request.resource.data.nickname.size() <= 20;
        allow delete: if isAdmin() || (signedIn() && (request.auth.uid == resource.data.userId || convId.matches('.*' + request.auth.uid + '.*')));
        allow update: if false;
      }
    }

    match /messageReports/{reportId} {
      allow read: if false;
      allow create: if false;
      allow update, delete: if false;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && !username.matches('.*\\s.*')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@athyx-network\\.local$');
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwnUser(userId) && validOwnProfile();
      allow update: if (isOwnUser(userId)
          && request.resource.data.keys().hasOnly(['nickname', 'username', 'role', 'banned', 'online', 'lastSeen', 'updatedAt', 'deviceId'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 1
          && request.resource.data.nickname.size() <= 20
          && !request.resource.data.nickname.matches('.*\\s.*')
          && request.resource.data.username == resource.data.username
          && request.resource.data.role == resource.data.role
          && request.resource.data.banned == resource.data.banned
          && (!request.resource.data.keys().hasAny(['deviceId']) || (request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 100))
          && (!request.resource.data.keys().hasAny(['online']) || request.resource.data.online is bool)
          && (!request.resource.data.keys().hasAny(['lastSeen']) || request.resource.data.lastSeen is timestamp)
          && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is timestamp))
        || (isAdmin()
          && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['member', 'moderator', 'admin'])
          && (!request.resource.data.keys().hasAny(['banned']) || request.resource.data.banned is bool)
          && (!request.resource.data.keys().hasAny(['online']) || request.resource.data.online is bool)
          && (!request.resource.data.keys().hasAny(['lastSeen']) || request.resource.data.lastSeen is timestamp)
          && (!request.resource.data.keys().hasAny(['nickname']) || request.resource.data.nickname is string)
          && (!request.resource.data.keys().hasAny(['username']) || request.resource.data.username is string)
          && (!request.resource.data.keys().hasAny(['deviceId']) || request.resource.data.deviceId is string));
      allow delete: if isAdmin();
    }

    match /site_presence/{visitorId} {
      allow read, write: if true;
    }

    match /banned_devices/{deviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
